Output docs/glyph-families-viewer.gif

Require python3

Set Shell "zsh"
Set FontSize 18
Set Width 1600
Set Height 1100
Set Framerate 12
Set TypingSpeed 20ms
Set Theme "Catppuccin Mocha"

Hide
Type "./run-families.sh --mode patterns" Enter
Sleep 3s
Show
# Native whole-glyph bundles: 彡/ミ/ﾐ, 川/巛/ﾘ/ﾙ, then crossed forms.
Sleep 2s
Type "jj"
Sleep 2s
Type "jjj"
Sleep 2s
# Complete curved-return spellings, followed by multi-row tone columns.
Type "jjjjjj"
Sleep 2500ms
Type "k"
Type "]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]"
Sleep 2500ms
Hide
Type "q"
Sleep 500ms
